# ClipForge AI — environment variables
#
# These are set in the Netlify site configuration (Site configuration →
# Environment variables), NEVER in a file that is committed. Copy this file to
# .env only for local `netlify dev` use; .env is git-ignored.
#
# Not needed until Phase 2 — Phase 1 makes no network calls at all.

# Gemini API key. Stays server-side, inside the Netlify Functions only.
# The browser never receives it.
GEMINI_API_KEY=

# Optional. Overrides the default model without a code change, so a renamed or
# retired model can be swapped from the Netlify dashboard. Leave empty to use
# the default in netlify/functions/gemini-analyze.js.
GEMINI_MODEL=
